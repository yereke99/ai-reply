    "setup.steps.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS only lets an app open its own settings page, so the keyboard list has to be opened by hand."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS позволяет открыть только страницу самого приложения, поэтому список клавиатур нужно открыть вручную."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS тек қолданбаның өз бетін аша алады, сондықтан пернетақталар тізімін қолмен ашу керек."
          }
