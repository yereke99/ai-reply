        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы қолданбаның тілін өзгертеді. Пернетақтадағы жазулар пернетақтада таңдалған орналасуға сәйкес келеді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет язык этого приложения. Надписи на самой клавиатуре следуют выбранной на ней раскладке."
          }
        }
      }
    },
    "settings.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied messages are never stored and never logged. They are sent only when you tap a template, and are discarded as soon as the reply is inserted or the keyboard closes."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірілген хабарламалар сақталмайды және журналға жазылмайды. Олар тек сіз үлгіні басқанда жіберіледі және жауап кірістірілген немесе пернетақта жабылған соң жойылады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированные сообщения не сохраняются и не логируются. Они отправляются только когда вы нажимаете шаблон, и удаляются сразу после вставки ответа или закрытия клавиатуры."
          }
        }
      }
    },
