    "settings.service.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your own key, requests go straight to the provider from this device. With the service, the key stays on the server and you get an account, a plan and a daily limit."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өз кілтіңізбен сұраныс құрылғыдан тікелей провайдерге кетеді. Сервер режимінде кілт серверде қалады, ал сізде тіркелгі, тариф және күндік лимит болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Со своим ключом запросы идут с устройства напрямую к провайдеру. С сервисом ключ остаётся на сервере, а у вас появляются аккаунт, тариф и дневной лимит."
          }
        }
      }
    },
