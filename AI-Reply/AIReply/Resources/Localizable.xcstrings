    "home.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing leaves your device. Replies are produced on device, the clipboard is never monitored in the background, and message text is never written to logs."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ешнәрсе құрылғыдан шықпайды. Жауаптар құрылғының өзінде жасалады, алмасу буфері фонда бақыланбайды, хабарлама мәтіні журналға жазылмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не покидает устройство. Ответы формируются на устройстве, буфер обмена не отслеживается в фоне, текст сообщений не записывается в логи."
          }
        }
      }
    },
