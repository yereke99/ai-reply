    "account.error.paymentRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plan needs payment first."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл тариф үшін алдымен төлем қажет."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого тарифа сначала нужна оплата."
          }
        }
      }
    },
    "account.error.sessionExpired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session ended. Please sign in again."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия аяқталды. Қайта кіріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия завершена. Войдите снова."
          }
        }
      }
    },
    "account.error.tooManyAttempts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait a little and try again."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әрекет тым көп. Сәл күтіп, қайталаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток. Подождите немного."
          }
        }
      }
    },
    "account.legal.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing you accept the terms of use and the privacy policy. Your conversations are not stored."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалғастыру арқылы пайдалану шарттары мен құпиялық саясатын қабылдайсыз. Жазысуыңыз сақталмайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжая, вы принимаете условия использования и политику конфиденциальности. Ваша переписка не сохраняется."
          }
        }
      }
    },
