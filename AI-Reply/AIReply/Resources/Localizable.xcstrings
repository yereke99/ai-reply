    "home.howItWorks.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy a message in WhatsApp, Telegram, Instagram or any other app, then switch to the AI Reply keyboard and tap Reply."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "WhatsApp, Telegram, Instagram немесе кез келген басқа қолданбада хабарламаны көшіріңіз, содан кейін AI Reply пернетақтасына ауысып, «Жауап беру» түймесін басыңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте сообщение в WhatsApp, Telegram, Instagram или любом другом приложении, переключитесь на клавиатуру AI Reply и нажмите «Ответить»."
          }
        }
      }
    },
    "home.howItWorks.fullAccess": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS requires Allow Full Access before any third-party keyboard can read copied text. The keyboard reads the clipboard only when you tap Reply — never in the background."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-та кез келген бөгде пернетақта көшірілген мәтінді оқуы үшін «Толық рұқсат» қажет. Пернетақта алмасу буферін тек «Жауап беру» түймесін басқанда ғана оқиды — фонда ешқашан оқымайды."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS требует «Полный доступ», чтобы сторонняя клавиатура могла читать скопированный текст. Клавиатура обращается к буферу обмена только после нажатия «Ответить» — и никогда в фоне."
          }
        }
      }
    },
    "home.howItWorks.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
