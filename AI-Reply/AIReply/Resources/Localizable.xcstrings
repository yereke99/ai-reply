    "settings.ai.key.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored only in this device's Keychain. It is never part of the app, never written to settings files, and never sent anywhere except OpenAI."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек осы құрылғының Keychain қоймасында сақталады. Қолданбаға кірмейді, баптау файлдарына жазылмайды және OpenAI-дан басқа ешқайда жіберілмейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится только в Связке ключей этого устройства. Никогда не входит в приложение, не пишется в файлы настроек и не отправляется никуда, кроме OpenAI."
          }
        }
      }
    },
