        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный доступ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Толық қолжетімділік"
          }
        }
      }
    },
    "setup.checklist.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күйі"
          }
        }
      }
    },
    "setup.checklist.unknown.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS does not tell an app whether its own keyboard is enabled. This turns green the first time the keyboard runs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не сообщает приложению, включена ли его клавиатура. Отметка появится после первого запуска клавиатуры."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS қолданбаға пернетақтасының қосылғанын хабарламайды. Белгі пернетақта алғаш іске қосылғанда пайда болады."
          }
        }
      }
    },
    "setup.fullAccess.manual": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you can turn it on, in Settings ▸ General ▸ Keyboard ▸ Keyboards ▸ AI Reply. No app can enable it for you."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить его можете только вы: «Настройки» ▸ «Основные» ▸ «Клавиатура» ▸ «Клавиатуры» ▸ AI Reply. Ни одно приложение не сделает это за вас."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оны тек өзіңіз қоса аласыз: «Баптаулар» ▸ «Негізгі» ▸ «Пернетақта» ▸ «Пернетақталар» ▸ AI Reply. Мұны ешбір қолданба сіздің орныңызға жасай алмайды."
          }
        }
      }
    },
    "setup.fullAccess.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный доступ"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Толық қолжетімділік"
          }
        }
      }
    },
    "setup.fullAccess.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Access lets the keyboard read the message you copied and reach the internet to write a reply. Without it the keyboard still types normally."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный доступ нужен, чтобы клавиатура могла прочитать скопированное сообщение и обратиться в интернет за ответом. Без него клавиатура печатает как обычная."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Толық қолжетімділік пернетақтаға сіз көшірген хабарламаны оқып, жауап алу үшін интернетке шығуға мүмкіндік береді. Онсыз да пернетақта әдеттегідей жаза береді."
          }
        }
      }
    },
    "setup.paste.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When iOS asks for permission to paste copied text, choose Allow. The keyboard only processes text you explicitly copied."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда iOS впервые спросит разрешение на вставку скопированного текста, нажмите «Разрешить». Это необходимо, чтобы клавиатура могла обработать сообщение, которое вы сами скопировали."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS көшірілген мәтінді қоюға рұқсат сұраса, «Рұқсат беру» таңдаңыз. Бұл сіз көшірген хабарламаны өңдеу үшін қажет."
          }
        }
      }
    },
    "setup.paste.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS shows that prompt itself, and only when the keyboard reads the clipboard after you tap a template."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот запрос показывает сама iOS — только когда клавиатура читает буфер обмена после нажатия на шаблон."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл сұрауды iOS өзі көрсетеді — тек үлгіні басқаннан кейін пернетақта алмасу буферін оқығанда."
          }
        }
      }
    },
    "setup.paste.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste permission"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на вставку"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қою рұқсаты"
          }
        }
      }
    },
    "setup.privacy.clipboard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard is never monitored in the background."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена никогда не отслеживается в фоне."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмасу буфері фонда ешқашан бақыланбайды."
          }
        }
      }
    },
    "setup.privacy.explicit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied text is read only after you tap a template, and a reply is generated only then."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированный текст читается только после нажатия на шаблон — тогда же создаётся ответ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көшірілген мәтін тек үлгіні басқаннан кейін оқылады, жауап та сол кезде ғана жасалады."
          }
        }
      }
    },
    "setup.privacy.noKeyInKeyboard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key lives in the iOS Keychain, never inside the keyboard or the app's files."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API хранится в Связке ключей iOS — не в клавиатуре и не в файлах приложения."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "API кілті iOS Кілттер тізбегінде сақталады — пернетақтада да, қолданба файлдарында да емес."
          }
        }
      }
    },
    "setup.privacy.secureFields": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords and secure fields are never processed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароли и защищённые поля никогда не обрабатываются."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құпия сөздер мен қорғалған өрістер ешқашан өңделмейді."
          }
        }
      }
    },
