    "account.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірдеңе дұрыс болмады. Қайталап көріңіз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Попробуйте ещё раз."
          }
        }
      }
    },
    "account.error.invalidCode": {
      "extractionState": "manual",
      "localizations": {
