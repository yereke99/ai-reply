{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "comment": "A step number, in the range 1–9.",
      "isCommentAutoGenerated": true
    },
    "account.code.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Растау"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердить"
          }
        }
      }
    },
    "account.code.demo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo mode: the server does not send anything yet — the code is 1111."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо режимі: сервер әзірге ештеңе жібермейді — код 1111."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Демо-режим: сервер пока ничего не отправляет — код 1111."
          }
        }
      }
    },
    "account.code.resend": {
      "extractionState": "manual",
      "localizations": {
