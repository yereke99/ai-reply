    "account.error.invalidNumber": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the number or e-mail and try again."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөмірді немесе поштаны тексеріп, қайталаңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте номер или почту и попробуйте снова."
          }
        }
      }
    },
    "account.error.limitReached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's replies are used up."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгінгі жауаптар бітті."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы на сегодня закончились."
          }
        }
