    "account.error.codeExpired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code has expired. Ask for a new one."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодтың мерзімі өтті. Жаңасын сұраңыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код истёк. Запросите новый."
          }
        }
      }
    },
    "account.error.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is disabled."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл тіркелгі өшірілген."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот аккаунт отключён."
          }
        }
