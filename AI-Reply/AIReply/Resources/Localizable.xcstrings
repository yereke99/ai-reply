          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалай жұмыс істейді"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как это работает"
          }
        }
      }
    },
