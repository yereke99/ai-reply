# ---------------------------------------------------------------------------
# AI Reply backend configuration.
#
# THIS FILE IS A TEMPLATE. Copy it to backend/.env and fill in real values.
# backend/.env is gitignored and is the ONLY place an OpenAI credential exists
# in this project. It is never bundled, never compiled and never shipped to a
# device.
# ---------------------------------------------------------------------------

# Required. Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_ME

# The model is configured here, once, and nowhere else. No iOS source file
# names a model.
OPENAI_MODEL=gpt-4o-mini

# Conservative output budget. A reply is 1-4 short sentences; this is sized for
# that plus headroom for Cyrillic and Kazakh, which tokenize less efficiently
# than English.
OPENAI_MAX_OUTPUT_TOKENS=180

# Upstream call timeout in milliseconds.
OPENAI_TIMEOUT_MS=20000

# Signs the short-lived client tokens the app exchanges its install id for.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SIGNING_SECRET=REPLACE_WITH_32_RANDOM_BYTES_HEX

# Token lifetime in seconds (default 30 days).
AUTH_TOKEN_TTL_SECONDS=2592000

# Per-client rate limits.
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_DAY=200

HOST=0.0.0.0
PORT=8787
