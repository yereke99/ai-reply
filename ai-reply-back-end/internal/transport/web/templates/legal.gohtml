{{define "title"}}{{.Title}} — AI Reply{{end}}
{{define "content"}}
<div class="wrap">
  <article class="legal">
    <h1>{{.Title}}</h1>
    <p><small>{{call .T "legal.updated"}}: {{.Updated}}</small></p>
    {{.Body}}
    <p style="margin-top:36px"><a class="btn btn-ghost" href="/?lang={{.Locale}}">{{call .T "legal.back"}}</a></p>
  </article>
</div>
{{end}}
