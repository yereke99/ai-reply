<?xml version="1.0" encoding="utf-8"?>
<!--
    Strings that have no iOS counterpart in Localizable.xcstrings.

    Two groups:

    * kb_* and key_* — on iOS these lived in two hand-written Swift tables
      (AIReplyStrings, KeyboardStrings) because a keyboard extension cannot see
      which language the containing app is set to. Android has no such gap: the
      keyboard resolves them through a configuration Context, so they are
      ordinary resources here and the duplication is gone.

    * android_* and voice_kb_* — genuinely new: Android keyboard enablement,
      the instruction field and dictation from inside the keyboard.
-->
<resources>

    <string name="app_name" translatable="false">AI Reply</string>

    <!-- IME subtype labels. Each layout is named in its own language, always. -->
    <string name="subtype_en" translatable="false">English</string>
    <string name="subtype_ru" translatable="false">Русский</string>
    <string name="subtype_kk" translatable="false">Қазақша</string>

    <!-- Key captions. These follow the KEYBOARD LAYOUT, never the app language. -->
    <string name="key_language_badge">EN</string>
    <string name="key_space">space</string>
    <string name="key_return">return</string>
    <string name="key_send">send</string>
    <string name="key_search">search</string>
    <string name="key_go">go</string>
    <string name="key_done">done</string>

    <!-- Reply panel actions. These follow the APP language. -->
